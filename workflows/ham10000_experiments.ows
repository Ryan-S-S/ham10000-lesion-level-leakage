</properties>
		<properties node_id="9" format="literal">{'activation_index': 3, 'alpha_index': 1, 'auto_apply': True, 'controlAreaVisible': True, 'hidden_layers_input': '100, ', 'learner_name': 'Intra sem dados clinicos', 'max_iterations': 100, 'replicable': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02\n\x00\x00\x00\xbe\x00\x00\x03L\x00\x00\x01\xfb\x00\x00\x02\x0b\x00\x00\x00\xdd\x00\x00\x03K\x00\x00\x01\xfa\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x02\x0b\x00\x00\x00\xdd\x00\x00\x03K\x00\x00\x01\xfa', 'solver_index': 2, '__version__': 2}</properties>
		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x05V\x00\x00\x02\xd8\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05U\x00\x00\x02\xd7\x00\x00\x00\x00\x02\x00\x00\x00\x05V\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05U\x00\x00\x02\xd7', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import DiscreteVariable\nfrom sklearn.model_selection import StratifiedKFold\n\nSEED = 42\nN_FOLDS = 5\n\n\ndef get_groups(table, name="lesion_id"):\n    if name not in table.domain:\n        raise ValueError(f"A coluna \'{name}\' não foi encontrada.")\n    var = table.domain[name]\n    col = table.get_column(var)\n    groups = []\n    for i, g in enumerate(col):\n        if var.is_discrete:\n            val = None if np.isnan(float(g)) else var.values[int(g)]\n        else:\n            if g is None or (isinstance(g, (float, np.floating)) and np.isnan(g)):\n                val = None\n            else:\n                val = str(g).strip()\n                if val.lower() in ("", "?", "nan", "none"):\n                    val = None\n        groups.append(val if val is not None else f"missing_{i}")\n    return np.array(groups, dtype=object)\n\n\n# 1. Entrada e alvo\nif in_data is None:\n    raise ValueError("Nenhuma tabela recebida.")\n\ntarget = in_data.domain.class_var\nif target is None:\n    raise ValueError("Defina dx como Target.")\n\ny = np.asarray(in_data.get_column(target), dtype=float).ravel()\nif np.any(np.isnan(y)):\n    raise ValueError("Existem diagnósticos ausentes.")\ny = y.astype(int)\n\nclasses, counts = np.unique(y, return_counts=True)\nif counts.min() &lt; N_FOLDS:\n    raise ValueError(f"Cada diagnóstico precisa ter pelo menos {N_FOLDS} imagens.")\n\n# 2. Divisão estratificada por diagnóstico (ignora a lesão de propósito)\ncv = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)\n\nfold_ids = np.full(len(y), -1, dtype=int)\nfor fold, (_, test_idx) in enumerate(cv.split(np.zeros(len(y)), y)):\n    fold_ids[test_idx] = fold\n\nif np.any(fold_ids == -1):\n    raise ValueError("Existem imagens sem fold atribuído.")\n\n# 3. Variável de fold (meta, não entra como atributo do modelo)\nfold_var = DiscreteVariable(\n    "fold_dx", values=[f"Fold_{i}" for i in range(N_FOLDS)]\n)\nout_data = in_data.add_column(fold_var, fold_ids, to_metas=True)\n\n# 4. Relatório\nprint("\\n========== K-FOLD INTRA (por imagem) ==========")\nprint(f"Semente: {SEED} | Folds: {N_FOLDS} | Total de imagens: {len(y)}")\n\nfor fold in range(N_FOLDS):\n    idx = np.where(fold_ids == fold)[0]\n    print(f"\\nFold {fold}: {len(idx)} imagens")\n    for cls in classes:\n        c = np.sum(y[idx] == cls)\n        print(f"  {target.values[int(cls)]}: {c} ({c / len(idx) * 100:.2f}%)")\n\n# 5. Diagnóstico de vazamento (apenas informativo)\nif "lesion_id" in in_data.domain:\n    groups = get_groups(in_data)\n    lesion_folds = {}\n    for g, f in zip(groups, fold_ids):\n        lesion_folds.setdefault(g, set()).add(f)\n\n    n_lesions = len(lesion_folds)\n    n_split = sum(1 for s in lesion_folds.values() if len(s) &gt; 1)\n\n    leaked = 0\n    for g, f in zip(groups, fold_ids):\n        # a imagem tem "irmã" da mesma lesão em outro fold (portanto no treino)?\n        if len(lesion_folds[g]) &gt; 1:\n            leaked += 1\n\n    print("\\n--- Diagnóstico de vazamento (intra) ---")\n    print(f"Lesões distintas: {n_lesions}")\n    print(f"Lesões espalhadas em mais de um fold: {n_split} "\n          f"({n_split / n_lesions * 100:.2f}%)")\n    print(f"Imagens cuja lesão aparece em outro fold: {leaked} "\n          f"({leaked / len(y) * 100:.2f}%)")\n\nprint("\\nDIVISÃO CONCLUÍDA COM SUCESSO!")', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="11" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\x1a\x00\x00\x00M\x00\x00\x04&lt;\x00\x00\x02l\x00\x00\x01\x1b\x00\x00\x00l\x00\x00\x04;\x00\x00\x02k\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x01\x1b\x00\x00\x00l\x00\x00\x04;\x00\x00\x02k', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import DiscreteVariable\nfrom sklearn.model_selection import StratifiedGroupKFold\n\nSEED = 42\nN_FOLDS = 5\n\n\ndef get_groups(table, name="lesion_id"):\n    if name not in table.domain:\n        raise ValueError(f"A coluna \'{name}\' não foi encontrada.")\n    var = table.domain[name]\n    col = table.get_column(var)\n    groups = []\n    for i, g in enumerate(col):\n        if var.is_discrete:\n            val = None if np.isnan(float(g)) else var.values[int(g)]\n        else:\n            if g is None or (isinstance(g, (float, np.floating)) and np.isnan(g)):\n                val = None\n            else:\n                val = str(g).strip()\n                if val.lower() in ("", "?", "nan", "none"):\n                    val = None\n        groups.append(val if val is not None else f"missing_{i}")\n    return np.array(groups, dtype=object)\n\n\n# 1. Entrada, alvo e grupos\nif in_data is None:\n    raise ValueError("Nenhuma tabela recebida.")\n\ntarget = in_data.domain.class_var\nif target is None:\n    raise ValueError("Defina dx como Target.")\n\ny = np.asarray(in_data.get_column(target), dtype=float).ravel()\nif np.any(np.isnan(y)):\n    raise ValueError("Existem diagnósticos ausentes.")\ny = y.astype(int)\n\ngroups = get_groups(in_data, "lesion_id")\nif len(np.unique(groups)) &lt; N_FOLDS:\n    raise ValueError(f"São necessários pelo menos {N_FOLDS} grupos.")\n\nclasses = np.unique(y)\n\n# 2. Divisão agrupada por lesão e estratificada por diagnóstico\ncv = StratifiedGroupKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)\n\nfold_ids = np.full(len(y), -1, dtype=int)\nfor fold, (_, test_idx) in enumerate(cv.split(np.zeros(len(y)), y, groups)):\n    fold_ids[test_idx] = fold\n\nif np.any(fold_ids == -1):\n    raise ValueError("Existem imagens sem fold atribuído.")\n\n# 3. Verificação de vazamento: cada lesão deve estar em exatamente 1 fold\nlesion_folds = {}\nfor g, f in zip(groups, fold_ids):\n    lesion_folds.setdefault(g, set()).add(f)\n\nviolations = [g for g, s in lesion_folds.items() if len(s) != 1]\nif violations:\n    raise ValueError(\n        f"ERRO: {len(violations)} lesões aparecem em mais de um fold!"\n    )\n\n# 4. Variável de fold (meta)\nfold_var = DiscreteVariable(\n    "fold_lesion", values=[f"Fold_{i}" for i in range(N_FOLDS)]\n)\nout_data = in_data.add_column(fold_var, fold_ids, to_metas=True)\n\n# 5. Relatório\nprint("\\n========== K-FOLD INTER (por lesão) ==========")\nprint(f"Semente: {SEED} | Folds: {N_FOLDS} | Total de imagens: {len(y)}")\nprint(f"Lesões distintas: {len(lesion_folds)}")\nprint(f"Lesões compartilhadas entre folds: {len(violations)}")\n\nglobal_prop = {cls: np.mean(y == cls) * 100 for cls in classes}\n\nfor fold in range(N_FOLDS):\n    idx = np.where(fold_ids == fold)[0]\n    print(f"\\nFold {fold}: {len(idx)} imagens | "\n          f"{len(np.unique(groups[idx]))} lesões")\n    for cls in classes:\n        c = np.sum(y[idx] == cls)\n        print(f"  {target.values[int(cls)]}: {c} "\n              f"({c / len(idx) * 100:.2f}% | global {global_prop[cls]:.2f}%)")\n\nprint("\\nDIVISÃO CONCLUÍDA COM SUCESSO!")', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x01,\x00\x00\x00\xac\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
